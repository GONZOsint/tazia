# Copy to .env and edit (never commit .env).
# Prefer zero-friction installers: docker/coturn/install/ (Windows bat / macOS sh).
TURN_USER=tazia
TURN_PASS=change-me-to-a-long-secret
TURN_PORT=3478

# Host address peers will use in TAZIA "Server address":
#   turn:<EXTERNAL_IP>:3478
# Use your LAN IP for same-Wi‑Fi testing (ipconfig / ifconfig).
# Use the public IP (or hostname) when peers are on other networks / CGNAT.
# Set to "auto" with DETECT_EXTERNAL_IP=1 for public IP detection.
EXTERNAL_IP=192.168.1.10

# Set to 1 to try api.ipify.org when EXTERNAL_IP is empty or "auto" (needs outbound net).
DETECT_EXTERNAL_IP=0

# Set to 1 for verbose coturn logs (docker compose logs -f coturn).
# TURN_VERBOSE=0
